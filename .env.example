APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Embedded applications, framed by the /tibadesk/apps pages. Each is its own
# Laravel deployment; the origin is where that app is served. Leave blank to
# show the "not set up" state in the launcher instead of a dead iframe.
#
# The origin is the app's own root, without the /tibadesk/apps/<name> prefix the
# proxy adds: the proxy is what moves a request from under that prefix to here.
EMBEDDED_PHARMACY_ORIGIN=
EMBEDDED_DENTAL_ORIGIN=
EMBEDDED_EYE_ORIGIN=

# Shared secret each package uses to verify the SSO assertion this app signs when
# it hands a user over. Both sides must agree, and it must not be the same value
# as anything in the packages' own .env files.
EMBEDDED_PHARMACY_SSO_SECRET=
EMBEDDED_DENTAL_SSO_SECRET=
EMBEDDED_EYE_SSO_SECRET=

# Self-service trials. A trial is a real facility on a real licence that
# expires on its own; when it does, the facility becomes read-only rather than
# disappearing, and renewing needs no reactivation step. Set
# TIBADESK_TRIAL_ENABLED=false to close the sign-up page and the API behind it.
TIBADESK_TRIAL_ENABLED=true
TIBADESK_TRIAL_DAYS=14

# Where a locked-out user is told to go, shown under the sign-in form. Kept in
# step with the website's SITE.contact block.
TIBADESK_SUPPORT_PHONE="+255 623 173 537"
TIBADESK_SUPPORT_PHONE_HREF=tel:+255623173537
TIBADESK_SUPPORT_EMAIL=kadetech.online@gmail.com

# Where a contact-form enquiry is delivered. The form is only useful if something
# reads this address, so it is set rather than left blank.
TIBADESK_ENQUIRY_INBOX=kadetech.online@gmail.com

# Shared secret for the internal quote endpoint. Quote requests are refused with
# a 503 while this is blank, which is deliberate: the endpoint hands out package
# pricing and must not answer the public.
TIBADESK_QUOTE_TOKEN=

# Mobile money, used to take payment for a subscription. The driver is "fake" so
# a fresh checkout runs end to end without moving money; swap it for the real
# gateway and supply the API key before going live.
CLICKPESA_DRIVER=fake
CLICKPESA_BASE_URL=https://api.clickpesa.com
CLICKPESA_API_KEY=
CLICKPESA_RETURN_URL="${APP_URL}/checkout/complete"
CLICKPESA_CALLBACK_URL="${APP_URL}/api/clickpesa/callback"

# Social links in the footer of the public site. Blank means the link is hidden
# rather than rendered pointing nowhere.
VITE_SOCIAL_LINKEDIN=
VITE_SOCIAL_FACEBOOK=
VITE_SOCIAL_X=
